{
  "ConnectionStrings": { "DefaultConnection": "" },
  "JWT": {
    "ValidIssuer": "TicketingApi",
    "ValidAudience": "TicketingClient",
    "ExpirationMinutes": 43200,
    "RefreshTokenExpirationDays": 90
  },
  "Authentication": {
    "RateLimit": { "PermitLimit": 10, "WindowSeconds": 60 }
  },
  "Database": { "ApplyMigrationsOnStartup": false },
  "ReplyReminders": { "Enabled": true, "DelaySeconds": 300, "PollIntervalSeconds": 15 },
  "Cors": { "AllowedOrigins": [] },
  "Logging": {
    "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" }
  },
  "AllowedHosts": "*"
}
